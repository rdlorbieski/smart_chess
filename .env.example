# Lido automaticamente pelo docker compose (mesma pasta do docker-compose.yml).
# Copie para .env e preencha. O .env não vai para o git.

# Quantos processos do Stockfish a API mantém abertos.
# Vazio = automático (núcleos - 2, máx. 6).
ENGINE_POOL=

# Token pessoal do Lichess (lichess.org/account/oauth/token, sem permissões),
# usado no Explorer → Masters. Vazio = colar no próprio app.
LICHESS_TOKEN=

# Login do site (usuário único). Sem AUTH_PASSWORD a API fica aberta (bom para uso local).
AUTH_USER=
AUTH_PASSWORD=

# "Esqueci a senha": manda um código de acesso de uso único para RECOVERY_EMAIL.
# Com Gmail: SMTP_USER = conta que envia e SMTP_PASS = senha de app de 16 letras
# (myaccount.google.com/apppasswords; exige verificação em duas etapas).
RECOVERY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
